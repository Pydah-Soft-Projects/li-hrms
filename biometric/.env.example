# Server Configuration
PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/biometric_logs

# HRMS MongoDB (for export: employee name, department, division)
HRMS_MONGODB_URI=mongodb://localhost:27017/hrms

# HRMS Backend Configuration (internal sync target for ADMS + Mongo replay)
BACKEND_URL=http://localhost:5000
HRMS_MICROSERVICE_SECRET_KEY=your-microservice-secret-key-here

# When live POST to HRMS fails (connection lost / timeout), punches stay pending in biometric Mongo
# and this worker resends them once GET {BACKEND_URL}/health succeeds. Existing logs without
# hrmsSyncStatus are never replayed. Catch-up only covers punches received within LOOKBACK hours.
# HRMS_CATCHUP_ENABLED=true
# HRMS_CATCHUP_INTERVAL_MS=30000
# HRMS_CATCHUP_BATCH_SIZE=200
# HRMS_CATCHUP_LOOKBACK_HOURS=48
# HRMS_CATCHUP_MAX_ATTEMPTS=8
# HRMS_CATCHUP_BATCH_GAP_MS=500
# HRMS_CATCHUP_MAX_BATCHES_PER_TICK=5
# HRMS_CATCHUP_PENDING_ALERT_THRESHOLD=100
# HRMS_LIVE_SYNC_TIMEOUT_MS=5000
# Status: GET /api/hrms-sync/status   Manual drain: POST /api/hrms-sync/catch-up-now
# Mongo-only replay (no device): POST /api/internal/replay-window-to-hrms with header x-system-key (same as above).
# Called by HRMS after employee verify when backend env BIOMETRIC_SERVICE_BASE_URL points at this service.

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
# Optional fallback mode when DB setting is not set:
# OPERATION -> use operation from device payload
# DEVICE -> override operation based on each device.operationGroup
# BIOMETRIC_OPERATION_MODE=OPERATION

# Fresh ADMS backup (POST .../attendance/backup-adms-fresh): wait until no new ATTLOG for quiet period, up to hard cap.
# While that runs, ATTLOG pushes still save to this service (Mongo) but are not POSTed to HRMS (avoids duplicate backend rows).
# ADMS_FRESH_BACKUP_HARD_CAP_MS=3600000
# ADMS_FRESH_BACKUP_QUIET_PERIOD_MS=12000
# ADMS_FRESH_BACKUP_FIRST_BATCH_WAIT_MS=180000
# Max hardCapMs the API may request in JSON body (default 7200000 = 2h). Lower if reverse proxies time out.
# ADMS_FRESH_BACKUP_API_HARD_CAP_MS=7200000

# Device "Live" in dashboard: lastSeenAt must be newer than this (milliseconds). Default 180000 = 3 minutes.
DEVICE_HEARTBEAT_STALE_MS=180000

# JSON backups are always written under DEVICE_ATTLOG_BACKUP_DIR (default: biometric/data/device-attlog-backups).
# S3 is optional: uploads run only after the local file is saved.
# DEVICE_ATTLOG_BACKUP_DIR=D:\\backups\\biometric-attlog

# Optional: after each ATTLOG backup JSON is written locally, also upload to S3
# ATTLOG_BACKUP_S3_ENABLED=true
# AWS_S3_BUCKET_NAME=your-bucket-name
# (alternatives: ATTLOG_BACKUP_S3_BUCKET or AWS_S3_BUCKET)
# ATTLOG_BACKUP_S3_PREFIX=device-attlog-backups/
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MinIO / custom endpoint (optional):
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true

# When DeviceUser already exists for a PIN, push DATA UPDATE USERINFO to the same device if the terminal payload still mismatches DB (set false to disable)
# SYNC_STORED_DEVICEUSER_TO_TERMINAL=true

# Auto-clone new users to other devices in the same machine category (requires device.categoryId + category.autoCloneEnabled)
# Prefer configuring via biometric dashboard → Settings tab (stored in MongoDB; overrides .env when set)
# AUTO_CLONE_NEW_USERS=true

# API Security (optional - add authentication token if needed)
# API_KEY=your_secret_key_here
